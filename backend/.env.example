APP_NAME=CTV-AI Core
API_V1_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3001,http://localhost:3001,http://192.168.31.42:3001
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OLLAMA_NUM_PREDICT=768
OLLAMA_THINK=false
CTV_ONE_MODEL_ROUTER_ENABLED=true
CTV_ONE_MODEL_FAST=qwen3:8b
CTV_ONE_MODEL_BALANCED=qwen3:8b
CTV_ONE_MODEL_REASONING=deepseek-r1:14b
CTV_ONE_MODEL_OPERATIONS=qwen3:8b
CTV_ONE_MODEL_KNOWLEDGE=qwen3:8b
CTV_ONE_MODEL_DEFAULT=qwen3:8b
CTV_ONE_MODEL_AVAILABILITY_TTL_SECONDS=300
CTV_ONE_MODEL_WARMUP_KEEP_ALIVE=10m
COMPANY_BRAIN_MAX_KNOWLEDGE_CHUNKS=4
COMPANY_BRAIN_MAX_KNOWLEDGE_CHARS=3200
COMPANY_BRAIN_MAX_OPERATIONAL_TASKS=6
COMPANY_BRAIN_MAX_OPERATIONAL_CHARS=2200
COMPANY_BRAIN_MAX_EMPLOYEE_CHARS=900
COMPANY_BRAIN_MAX_HISTORY_MESSAGES=4
COMPANY_BRAIN_MAX_HISTORY_CHARS=1200
COMPANY_BRAIN_MAX_TOTAL_PROMPT_CHARS=5200
OPERATIONS_SYNC_ENABLED=true
OPERATIONS_SYNC_INTERVAL_SECONDS=300
OPERATIONS_SNAPSHOT_MAX_AGE_SECONDS=300
OPERATIONS_SYNC_TIMEOUT_SECONDS=60
CTV_AI_API_KEY=ctv-ai-local
DATABASE_URL=postgresql+asyncpg://ctvai:ctvai_change_me@127.0.0.1:5432/ctvai
QDRANT_URL=http://127.0.0.1:6333
KNOWLEDGE_COLLECTION=ctv_company_knowledge
KNOWLEDGE_UPLOAD_DIR=B:\CTV_AI\company_data\ingested
KNOWLEDGE_MAX_FILE_MB=25
KNOWLEDGE_CHUNK_SIZE=900
KNOWLEDGE_CHUNK_OVERLAP=150
KNOWLEDGE_TOP_K=5
JWT_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=180
EMBEDDING_VALIDATION_TIMEOUT_SECONDS=10
PERFORMANCE_LOG_PATH=B:\CTV_AI\logs\performance.jsonl
PERFORMANCE_LOG_MAX_BYTES=5000000
PERFORMANCE_LOG_BACKUP_COUNT=5
# Company Brain semantic response cache (P2.5)
CTV_ONE_SEMANTIC_CACHE_ENABLED=true
CTV_ONE_SEMANTIC_CACHE_EXACT_ENABLED=true
CTV_ONE_SEMANTIC_CACHE_SIMILARITY_ENABLED=true
CTV_ONE_SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.94
CTV_ONE_SEMANTIC_CACHE_DEFAULT_TTL_SECONDS=86400
CTV_ONE_SEMANTIC_CACHE_OPERATIONS_TTL_SECONDS=900
CTV_ONE_SEMANTIC_CACHE_MAX_ANSWER_CHARS=12000
CTV_ONE_SEMANTIC_CACHE_MAX_CANDIDATES=5
CTV_ONE_SEMANTIC_CACHE_PROMPT_POLICY_VERSION=p2.5-v1
CTV_ONE_SEMANTIC_CACHE_ROUTER_POLICY_VERSION=p2.4.1-v1

# Monday snapshot reliability (P2.6)
CTV_ONE_OPERATIONS_SNAPSHOT_FRESH_SECONDS=900
CTV_ONE_OPERATIONS_SNAPSHOT_AGING_SECONDS=3600
CTV_ONE_OPERATIONS_SNAPSHOT_STALE_SECONDS=21600
CTV_ONE_MONDAY_SNAPSHOT_REFRESH_ENABLED=true
CTV_ONE_MONDAY_SNAPSHOT_REFRESH_INTERVAL_SECONDS=900
CTV_ONE_MONDAY_SNAPSHOT_REFRESH_ON_STARTUP=false
CTV_ONE_MONDAY_SNAPSHOT_RETRY_ATTEMPTS=3
CTV_ONE_MONDAY_SNAPSHOT_RETRY_BASE_SECONDS=0.5

# Process-local Ollama admission control (P2.8)
CTV_ONE_INFERENCE_QUEUE_ENABLED=true
CTV_ONE_INFERENCE_GLOBAL_CONCURRENCY=2
CTV_ONE_INFERENCE_GLOBAL_QUEUE_SIZE=20
CTV_ONE_INFERENCE_DEFAULT_TIMEOUT_SECONDS=180
CTV_ONE_INFERENCE_QUEUE_WAIT_TIMEOUT_SECONDS=120
CTV_ONE_INFERENCE_MODEL_QWEN3_8B_CONCURRENCY=2
CTV_ONE_INFERENCE_MODEL_DEEPSEEK_R1_14B_CONCURRENCY=1
CTV_ONE_INFERENCE_PER_USER_ACTIVE_LIMIT=1
CTV_ONE_INFERENCE_PER_USER_QUEUE_LIMIT=3
CTV_ONE_INFERENCE_SHUTDOWN_GRACE_SECONDS=30
CTV_ONE_INFERENCE_PRIORITY_AGING_SECONDS=30

# Executive Supervisor (V2.0 Chapter 1)
CTV_ONE_SUPERVISOR_ENABLED=true
CTV_ONE_SUPERVISOR_DEFAULT_MODE=auto
CTV_ONE_SUPERVISOR_LLM_PLANNING_ENABLED=true
CTV_ONE_SUPERVISOR_MAX_TASKS=6
CTV_ONE_SUPERVISOR_MAX_DEPTH=3
CTV_ONE_SUPERVISOR_MAX_PARALLEL_TASKS=3
CTV_ONE_SUPERVISOR_PLANNER_TIMEOUT_SECONDS=20
CTV_ONE_SUPERVISOR_TASK_TIMEOUT_SECONDS=60
CTV_ONE_SUPERVISOR_TOTAL_TIMEOUT_SECONDS=180
CTV_ONE_SUPERVISOR_FALLBACK_DIRECT=true
CTV_ONE_SUPERVISOR_CACHE_ENABLED=false
CTV_ONE_SUPERVISOR_STREAM_EVENTS_ENABLED=true

# Chapter 2 agent runtime and safe local-core limits
CTV_ONE_AGENT_RUNTIME_ENABLED=true
CTV_ONE_AGENT_HEALTH_POLL_ENABLED=true
CTV_ONE_AGENT_HEALTH_POLL_SECONDS=60
CTV_ONE_AGENT_HEALTH_TIMEOUT_SECONDS=5
CTV_ONE_AGENT_INITIALIZE_TIMEOUT_SECONDS=30
CTV_ONE_AGENT_SHUTDOWN_TIMEOUT_SECONDS=15
CTV_ONE_AGENT_FAILURE_THRESHOLD=3
CTV_ONE_AGENT_RECOVERY_SUCCESS_THRESHOLD=2
CTV_ONE_AGENT_KNOWLEDGE_ENABLED=true
CTV_ONE_AGENT_OPERATIONS_ENABLED=true
CTV_ONE_AGENT_EMPLOYEE_ENABLED=true
CTV_ONE_AGENT_REASONING_ENABLED=true
CTV_ONE_AGENT_COMPOSER_ENABLED=true
# Optional comma-separated stable capability IDs; ordinary requests cannot override this.
CTV_ONE_AGENT_DISABLED_CAPABILITIES=
CTV_ONE_AGENT_DEFAULT_MAX_INFERENCE_CALLS=1
CTV_ONE_AGENT_DEFAULT_MAX_RETRIEVAL_CALLS=3
CTV_ONE_AGENT_DEFAULT_MAX_EVIDENCE_ITEMS=12
CTV_ONE_AGENT_DEFAULT_MAX_OUTPUT_CHARS=16000
CTV_ONE_AGENT_DEFAULT_MAX_QUEUE_WAIT_SECONDS=120
CTV_ONE_AGENT_REASONING_TIMEOUT_SECONDS=90
CTV_ONE_AGENT_COMPOSER_TIMEOUT_SECONDS=120
CTV_ONE_AGENT_COMPOSITION_MAX_EVIDENCE_ITEMS=8
CTV_ONE_AGENT_COMPOSITION_MAX_CHARS_PER_RESULT=2500
CTV_ONE_AGENT_COMPOSITION_MAX_TOTAL_CHARS=8000
CTV_ONE_SEMANTIC_CACHE_HOT_EXACT_MAX_ENTRIES=128

# Atlas Enterprise Context Engine foundation (V2.0 Chapter 3.1)
# Atlas remains idle in this sprint: no providers, data collection, or LLM calls.
CTV_ONE_ATLAS_ENABLED=true
CTV_ONE_ATLAS_RUNTIME_VERSION=1.0.0
CTV_ONE_ATLAS_PROVIDER_CONTRACT_VERSION=1.0
CTV_ONE_ATLAS_CONTEXT_PACKAGE_VERSION=1.0
CTV_ONE_ATLAS_HEALTH_POLL_ENABLED=true
CTV_ONE_ATLAS_HEALTH_POLL_SECONDS=60
CTV_ONE_ATLAS_HEALTH_TIMEOUT_SECONDS=5
CTV_ONE_ATLAS_INITIALIZE_TIMEOUT_SECONDS=30
CTV_ONE_ATLAS_SHUTDOWN_TIMEOUT_SECONDS=15
CTV_ONE_ATLAS_FAILURE_THRESHOLD=3
CTV_ONE_ATLAS_RECOVERY_THRESHOLD=2
