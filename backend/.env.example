APP_NAME=CTV-AI Core
APP_VERSION=1.3.0
API_V1_PREFIX=/api/v1
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OLLAMA_NUM_PREDICT=768
OLLAMA_THINK=false
CTV_ONE_MODEL_ROUTER_ENABLED=true
CTV_ONE_MODEL_FAST=qwen3:8b
CTV_ONE_MODEL_BALANCED=qwen3:8b
CTV_ONE_MODEL_REASONING=deepseek-r1:14b
CTV_ONE_MODEL_OPERATIONS=qwen3:8b
CTV_ONE_MODEL_KNOWLEDGE=qwen3:8b
CTV_ONE_MODEL_DEFAULT=qwen3:8b
CTV_ONE_MODEL_AVAILABILITY_TTL_SECONDS=300
CTV_ONE_MODEL_WARMUP_KEEP_ALIVE=10m
COMPANY_BRAIN_MAX_KNOWLEDGE_CHUNKS=4
COMPANY_BRAIN_MAX_KNOWLEDGE_CHARS=3200
COMPANY_BRAIN_MAX_OPERATIONAL_TASKS=6
COMPANY_BRAIN_MAX_OPERATIONAL_CHARS=2200
COMPANY_BRAIN_MAX_EMPLOYEE_CHARS=900
COMPANY_BRAIN_MAX_HISTORY_MESSAGES=4
COMPANY_BRAIN_MAX_HISTORY_CHARS=1200
COMPANY_BRAIN_MAX_TOTAL_PROMPT_CHARS=5200
OPERATIONS_SYNC_ENABLED=true
OPERATIONS_SYNC_INTERVAL_SECONDS=300
OPERATIONS_SNAPSHOT_MAX_AGE_SECONDS=300
OPERATIONS_SYNC_TIMEOUT_SECONDS=60
CTV_AI_API_KEY=ctv-ai-local
DATABASE_URL=postgresql+asyncpg://ctvai:ctvai_change_me@127.0.0.1:5432/ctvai
QDRANT_URL=http://127.0.0.1:6333
KNOWLEDGE_COLLECTION=ctv_company_knowledge
KNOWLEDGE_UPLOAD_DIR=B:\CTV_AI\company_data\ingested
KNOWLEDGE_MAX_FILE_MB=25
KNOWLEDGE_CHUNK_SIZE=900
KNOWLEDGE_CHUNK_OVERLAP=150
KNOWLEDGE_TOP_K=5
JWT_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=180
EMBEDDING_VALIDATION_TIMEOUT_SECONDS=10
PERFORMANCE_LOG_PATH=B:\CTV_AI\logs\performance.jsonl
PERFORMANCE_LOG_MAX_BYTES=5000000
PERFORMANCE_LOG_BACKUP_COUNT=5
# Company Brain semantic response cache (P2.5)
CTV_ONE_SEMANTIC_CACHE_ENABLED=true
CTV_ONE_SEMANTIC_CACHE_EXACT_ENABLED=true
CTV_ONE_SEMANTIC_CACHE_SIMILARITY_ENABLED=true
CTV_ONE_SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.94
CTV_ONE_SEMANTIC_CACHE_DEFAULT_TTL_SECONDS=86400
CTV_ONE_SEMANTIC_CACHE_OPERATIONS_TTL_SECONDS=900
CTV_ONE_SEMANTIC_CACHE_MAX_ANSWER_CHARS=12000
CTV_ONE_SEMANTIC_CACHE_MAX_CANDIDATES=5
CTV_ONE_SEMANTIC_CACHE_PROMPT_POLICY_VERSION=p2.5-v1
CTV_ONE_SEMANTIC_CACHE_ROUTER_POLICY_VERSION=p2.4.1-v1
